<Window x:Class="Sticky_Notes.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sticky_Notes.UI"
        mc:Ignorable="d"
        Title="Sticky Notes"
        Height="630" Width="320"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border Background="#202020"
            BorderBrush="#717171"
            BorderThickness=".5"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border Background="Transparent"
                    MouseDown="Border_MouseDown"/>
            <Button Style="{StaticResource WindowButton}"
                    ToolTip="Close Window"
                    ToolTipService.Placement="Top"
                    Click="Button_Click"
                    HorizontalAlignment="Right">
                <Image Source="C:\Users\Nima\source\repos\Sticky Notes\Sticky Notes.UI\Assets\CloseWindow.png"
                       Width="14"
                       Height="14"/>
            </Button>
            
            <ContentControl Grid.RowSpan="2"
                            Content="{Binding Navigation.CurrentView}"
                            Focusable="False"/>
        </Grid>
    </Border>
</Window>