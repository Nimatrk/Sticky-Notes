<UserControl x:Class="Sticky_Notes.UI.MVVM.View.NotesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Sticky_Notes.UI.MVVM.View"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="630" d:DesignWidth="320">

    <UserControl.Resources>
        <Style x:Key="SearchBox"
               TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#eeeeee"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <TextBox x:Name="textbox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}"
                                     BorderThickness="{TemplateBinding BorderThickness}"
                                     VerticalContentAlignment="Center" Margin="6 0 40 0"/>
                            <TextBlock x:Name="watermark" Text="Search..."
                                       Foreground="#717171" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Hidden" Margin="11 0 0 0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                <Setter TargetName="textbox" Property="Margin" Value="7.5 0 0 0"/>
                                <Setter TargetName="watermark" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                <Setter TargetName="textbox" Property="Margin" Value="7.5 0 0 0"/>
                                <Setter TargetName="watermark" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Button Style="{StaticResource WindowButton}" Command="{Binding NavigateSettingsCommand}"
                ToolTip="Settings" ToolTipService.Placement="Top" HorizontalAlignment="Right" Margin="0 0 40 0">
            <Image Source="C:\Users\Nima\source\repos\Sticky Notes\Sticky Notes.UI\Assets\Settings.png"
                   Width="18" Height="18"/>
        </Button>

        <Button Style="{StaticResource WindowButton}" Command="{Binding AddNoteCommand}"
                ToolTip="New Note" ToolTipService.Placement="Top" HorizontalAlignment="Left">
            <Image Source="C:\Users\Nima\source\repos\Sticky Notes\Sticky Notes.UI\Assets\Add.png"
                   Width="16" Height="16"/>
        </Button>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1"
                  Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="Sticky Notes" FontSize="22" Foreground="#ffffff"/>

                <!-- Search Box -->
                <Border Background="#404040" Grid.Row="2" Height="31" Margin="1 0 1 0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7.5*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Style="{StaticResource SearchBox}"/>
                        <Button Command="{Binding ClearSearchCommand}" HorizontalAlignment="Right">
                            <Button.Content>
                                <Image Source="C:\Users\Nima\source\repos\Sticky Notes\Sticky Notes.UI\Assets\ClearSearch.png"
                                       Width="10" Height="10"/>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Width" Value="35"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#4d4d4d"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="1">
                            <Button.Content>
                                <Image Source="C:\Users\Nima\source\repos\Sticky Notes\Sticky Notes.UI\Assets\search.png"
                                       Width="12"/>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#4d4d4d"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <ListView Grid.Row="4"
                          ItemsSource="{Binding Notes,UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                          SelectedItem="{Binding SelectedNote, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                          Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <EventSetter Event="MouseDoubleClick" Handler="ListViewItem_MouseDoubleClick"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Grid Margin="0 10 0 0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="5"/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            
                                            <Border Background="#64bf59" CornerRadius="8 8 0 0"/>
                                            <Border Grid.Row="1" Background="#333333" MinHeight="40" MaxWidth="297">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Text="{Binding Note.CreationDateTime, StringFormat='{}{0:MM/dd/yyyy a\\t h:mm tt}'}"
                                                               Foreground="#78d56c" HorizontalAlignment="Right" Margin="0 5 5 0"/>

                                                    <TextBox x:Name="noteText"
                                                             Grid.Row="1" Text="{Binding Note.Text, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                             Background="Transparent" Foreground="#eeeeee"
                                                             BorderBrush="Transparent" BorderThickness="0"
                                                             TextWrapping="Wrap" AcceptsReturn="True"
                                                             IsHitTestVisible="False" Focusable="False"
                                                             MaxLines="5" Margin="5">
                                                    </TextBox>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value=".9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
